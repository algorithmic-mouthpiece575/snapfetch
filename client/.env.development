# Backend origin in development, used for downloads
# (bypasses the Vite proxy which times out on large files — see lib/api.ts).
VITE_API_ORIGIN=http://localhost:3001

# Project GitHub repository (owner/repo) for the "star the project" button
# and its star counter. Leaving it empty only hides the counter.
VITE_GITHUB_REPO=Zeh-Eox/snapfetch
