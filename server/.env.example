# HTTP server port
PORT=3001

# Allowed CORS origin (frontend URL in dev)
CLIENT_ORIGIN=http://localhost:5173

# Path to the yt-dlp executable (keep "yt-dlp" if it's on the PATH)
YTDLP_PATH=yt-dlp

# Max time (ms) to resolve metadata before giving up
RESOLVE_TIMEOUT_MS=20000

# Max time (ms) for a full download (large HD files)
DOWNLOAD_TIMEOUT_MS=600000

# Window (ms) and max number of requests for per-IP rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- yt-dlp authentication (optional) ---
# Required for Instagram (and sometimes X) which need a logged-in session.
# Option 1 (simplest): read cookies from a browser where you are logged in.
#   Possible values: firefox, chrome, chromium, brave, edge, opera, vivaldi
YTDLP_COOKIES_FROM_BROWSER=
# Option 2: path to a Netscape-format cookies file (cookies.txt).
#   Takes precedence over the option above when set.
YTDLP_COOKIES_FILE=
